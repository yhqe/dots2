/**
 * Tomorrow Night Burns — Rofi Theme
 * Font: DejaVuSansMono Nerd Font Mono 7
 */

* {
    /* ── Palette ─────────────────────────────────── */
    bg0:    #1d1f21;   /* base background             */
    bg1:    #282a2e;   /* current line / alt row      */
    bg2:    #373b41;   /* selection / highlight bg    */
    fg0:    #c5c8c6;   /* primary text                */
    fg1:    #969896;   /* comment / subtle            */
    red:    #cc6666;
    orange: #cc6666;   /* the "burns" accent          */
    yellow: #832e31;
    green:  #b5bd68;
    teal:   #8abeb7;
    blue:   #81a2be;
    purple: #b294bb;

    font:               "DejaVuSansM Nerd Font Mono 7";
    background-color:   transparent;
    text-color:         @fg0;
}

/* ── Window ────────────────────────────────────────── */
window {
    background-color:   @bg0;
    border:             1px solid;
    border-color:       @orange;
    border-radius:      0px;
    padding:            0px;
    width:              30%;
}

/* ── Layout ────────────────────────────────────────── */
mainbox {
    background-color:   transparent;
    padding:            0px;
    spacing:            0px;
    children:           [ inputbar, listview, message ];
}

/* ── Input bar ─────────────────────────────────────── */
inputbar {
    background-color:   @bg1;
    border:             0px 0px 1px 0px;
    border-color:       @bg2;
    padding:            6px 8px;
    spacing:            4px;
    children:           [ prompt, entry ];
}

prompt {
    background-color:   transparent;
    text-color:         @orange;
}

entry {
    background-color:   transparent;
    text-color:         @fg0;
    cursor-color:       @orange;
    placeholder:        "  search";
    placeholder-color:  @fg1;
}

/* ── List ──────────────────────────────────────────── */
listview {
    background-color:   transparent;
    padding:            4px;
    spacing:            1px;
    scrollbar:          false;
    lines:              10;
    columns:            1;
    cycle:              true;
    dynamic:            true;
}

element {
    background-color:   transparent;
    border-radius:      0px;
    padding:            3px 6px;
    spacing:            6px;
    orientation:        horizontal;
}

element-icon {
    background-color:   transparent;
    size:               1em;
    vertical-align:     0.5;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    highlight:          bold #ff443e;
    vertical-align:     0.5;
}

/* normal rows */
element normal.normal  { background-color: transparent; text-color: @fg0;    }
element normal.urgent  { background-color: transparent; text-color: @red;    }
element normal.active  { background-color: transparent; text-color: @green;  }

/* selected row */
element selected.normal { background-color: @bg2; text-color: @orange;  }
element selected.urgent { background-color: @bg2; text-color: @red;     }
element selected.active { background-color: @bg2; text-color: @teal;    }

/* alternate rows */
element alternate.normal { background-color: @bg1; text-color: @fg0;   }
element alternate.urgent { background-color: @bg1; text-color: @red;   }
element alternate.active { background-color: @bg1; text-color: @green; }

/* ── Message / error bar ───────────────────────────── */
message {
    background-color:   @bg1;
    border:             1px 0px 0px 0px;
    border-color:       @bg2;
    padding:            4px 8px;
}

textbox {
    background-color:   transparent;
    text-color:         @yellow;
}

